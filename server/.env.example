# SocialLens Server — Environment Variables

# Port the backend server listens on
# Default: 5001
PORT=5001

# Google Gemini API Key (Optional)
# Get a free key at: https://aistudio.google.com/app/apikey
# If left empty, the application automatically uses built-in smart heuristics.
# The application is fully functional without this key.
GEMINI_API_KEY=
